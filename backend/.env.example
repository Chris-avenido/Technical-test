PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MySQL Connection (e.g. docker container or local MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/food_finder"

# Stripe Test Keys (Get test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_mockKeyForExamTesting51234567890
STRIPE_WEBHOOK_SECRET=whsec_mockWebhookSecretForExam123456789
# Optional: Set a specific Stripe Price ID (e.g. price_1...), or leave blank/mock to automatically use dynamic $9.99/mo price_data
STRIPE_MONTHLY_PRICE_ID=

